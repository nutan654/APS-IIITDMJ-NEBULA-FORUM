datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  password  String
  name      String
  role      String             @default("NOVICE") // NOVICE, SCHOLAR, HIGH_PRIEST
  title     String             @default("Novice Stargazer")
  createdAt DateTime           @default(now())
  posts     ForumPost[]
  bookings  TelescopeBooking[]
  rsvps     EventRSVP[]
}

model CelestialEvent {
  id          Int         @id @default(autoincrement())
  title       String
  type        String      // Stargazing Session, Workshop, Summer Solstice, Lecture, Meteor Watch, Eclipse Event
  month       String      // e.g. "Jun", "Jul", "Aug"
  day         String      // e.g. "06", "14", "21"
  description String
  capacity    Int         @default(30)
  rsvps       EventRSVP[]
  createdAt   DateTime    @default(now())
}

model EventRSVP {
  id        Int            @id @default(autoincrement())
  userId    Int
  eventId   Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CelestialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, eventId])
}

model ForumPost {
  id             Int      @id @default(autoincrement())
  title          String
  content        String
  tag            String   // Astrophotography, Theory, Question, Discovery, Observation
  userId         Int
  author         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes          Int      @default(0)
  responsesCount Int      @default(0)
  createdAt      DateTime @default(now())
}

model TelescopeBooking {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument String   // e.g. "8\" Dobsonian Reflector, f/6", "4\" Refractor, Celestron NexStar"
  date       String   // e.g. "2026-06-05"
  timeSlot   String   // e.g. "20:00 - 22:00", "22:00 - 00:00", "00:00 - 02:00"
  purpose    String
  status     String   @default("APPROVED") // APPROVED, PENDING, CANCELLED
  createdAt  DateTime @default(now())
}

model KnowledgeBase {
  id       Int    @id @default(autoincrement())
  topic    String // e.g. "Relativity", "Quantum", "Black Holes", "ISRO"
  keywords String // comma-separated query triggers
  question String
  answer   String
}
